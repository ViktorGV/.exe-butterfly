# Copy this file to .env.local (gitignored) and fill in the values.
# Never commit real keys. Share secrets privately (password manager), not in git or chat.

# OpenRouter key for all AI generation. Prefer one key per person with a small credit limit.
OPENROUTER_API_KEY=

# Must be the SAME for everyone: it decides which usernames match a submission.
# Any long random string, e.g. `bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())"`.
EVENT_ROSTER_SECRET=

# Optional: set to 1 to run without real AI calls.
# WOBBLE_AI_MOCK=1

# Optional model overrides (defaults live in packages/ai).
# WOBBLE_AI_MODEL_FAST=
# WOBBLE_AI_MODEL_SMART=
# WOBBLE_AI_MODEL_IMAGE=
# WOBBLE_AI_MODEL_VISION=
