{
  "name": "wobble-rush-3d",
  "private": true,
  "version": "0.0.0",
  "description": "Wobble Rush 3D: a browser obstacle-course party racer for up to 300 players, with LLM-generated assets.",
  "type": "module",
  "engines": {
    "bun": ">=1.4"
  },
  "workspaces": [
    "packages/shared",
    "apps/web",
    "apps/server",
    "tools/loadtest",
    "tools/event"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:web": "bun run --filter @wobble/web dev",
    "dev:server": "bun run --filter @wobble/server dev",
    "build": "bun run --filter @wobble/web build",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.16.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "@types/bun": "^1.4.5",
    "typescript-eslint": "^8.74.0"
  },
  "packageManager": "bun@1.4.4"
}
